// copy this folder to pub-plan/ (gitignored), then:
//   wrangler kv namespace create tyat-inbox   → put the id below
//   wrangler secret put PLAN_KEY              → same value as ../.plan-key
//   t page --publish
{
  "name": "tyat-plan",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "kv_namespaces": [{ "binding": "INBOX", "id": "<your kv namespace id>" }]
}
