def fzf(lines, query="", prompt="› "):
    if not shutil.which("fzf"): sys.exit("needs fzf (brew install fzf)")
    r = subprocess.run(["fzf", "--ansi", "--reverse", "--height=60%", "--delimiter=\t", "--with-nth=2..",
                        "--select-1", "--exit-0", "--prompt", prompt, "--query", query],
                       input="\n".join(lines), stdout=subprocess.PIPE, text=True)
    return r.stdout.strip().split("\t", 1)[0] if r.returncode == 0 and r.stdout.strip() else None


def project_dirs():
    seen, out = set(), []
    nowts = dt.datetime.now().timestamp()
    for h in history():
        p = h["cwd"]
        if p not in seen and p.startswith(str(ROOT)) and Path(p).is_dir():
            seen.add(p); out.append((p, ago(nowts - h["ts"])))
    for g in sorted(ROOT.glob("*/.git")) + sorted(ROOT.glob("*/*/.git")) + sorted(ROOT.glob("*/*/*/.git")):
        p = str(g.parent)
        if p not in seen and "/_archive" not in p:
            seen.add(p); out.append((p, ""))
    return out


def open_cmd(query):
    dirs = project_dirs()
    pick = fzf([f"{p}\t{pad(dim(a), 6)} {short(p)}" for p, a in dirs], " ".join(query), "folder › ")
    if not pick: return
    folder = Path(pick)
    via, resume = choose(folder, folder.name)
    if via is None: return
    argv, _ = build_argv(via, None, folder.name, resume)
    launch(folder, via, argv)


def recent_cmd(query):
    ss = ordered_sessions()
    live = {s["sid"]: i for i, s in enumerate(ss, 1) if s["sid"]}
    nowts = dt.datetime.now().timestamp()
    rows = [h for h in history()[:80] if h["sid"] in live or session_exists(h["sid"])]
    lines = [f"{h['sid']}\t{pad(dim(ago(nowts - h['ts'])), 6)} {grn('● ') if h['sid'] in live else '  '}"
             f"{pad(short(h['cwd'])[:34], 34)}  {h['last'][:80]}" for h in rows]
    sid = fzf(lines, " ".join(query), "resume › ")
    if not sid: return
    if sid in live: return jump(ss, live[sid])
    h = next(h for h in rows if h["sid"] == sid)
    if not Path(h["cwd"]).is_dir(): sys.exit(f"folder gone: {h['cwd']}")
    launch(Path(h["cwd"]), "claude", ["claude", "--resume", sid])


def session_exists(sid):
    return any((HOME / ".claude/projects").glob(f"*/{sid}.jsonl"))


# ── check: a small model reads the evidence, rules do the rescheduling ───────
# The model only answers "is this task done?" from what happened in its folder. Times are never its job:
# late tasks get the slot schedule() gives them in the coming blocks.
CHECK_HOURS = int(os.environ.get("TYAT_CHECK_HOURS", 72))      # how far back evidence counts
CHECK_MIN = float(os.environ.get("TYAT_CHECK_MIN", 0.85))      # confidence needed to mark a task done
CHECK_CACHE = APP / ".check.json"                               # evidence hash + last verdict per task
CHECK_LOG = APP / ".check.log"                                  # every change --apply made, for undoing by hand
PROJECTS = HOME / ".claude" / "projects"


def git_log(d, since):
    try:
        r = subprocess.run(["git", "-C", str(d), "log", f"--since={since:%Y-%m-%dT%H:%M}", "-n", "6", "--format=%ad %s",
                            "--date=format:%d.%m %H:%M", "--", "."], capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired): return []
    return r.stdout.strip().splitlines() if r.returncode == 0 else []


def touched(d, since, limit=5):
    """Newest files changed in d (3 levels deep) since `since`; the task file itself never counts."""
    cut, out = since.timestamp(), []
    for dirpath, dirs, files in os.walk(d):
        dirs[:] = [x for x in dirs if x not in SKIP_DIRS and not x.startswith(".")]
        if len(Path(dirpath).relative_to(d).parts) >= 2: dirs[:] = []
        for f in files:
            p = Path(dirpath) / f
            if p in (TASKS, INBOX) or f.startswith("."): continue
            try: m = p.stat().st_mtime
            except OSError: continue
            if m >= cut: out.append((m, p))
    return [f"{dt.datetime.fromtimestamp(m):%d.%m %H:%M} {p.relative_to(d)}" for m, p in sorted(out, reverse=True)[:limit]]


def transcript_tail(path, n=4, width=400):
    """Last n user/assistant text messages of a Claude Code transcript (reads only its last 400 kB)."""
    msgs = []
    try:
        with path.open("rb") as f:
            f.seek(max(0, path.stat().st_size - 400_000))
            lines = f.read().decode(errors="ignore").splitlines()[1:]
    except OSError: return []
    for line in lines:
        try: m = json.loads(line)
        except ValueError: continue
        if m.get("type") not in ("user", "assistant") or m.get("isMeta"): continue
        c = m.get("message", {}).get("content")
        texts = [c] if isinstance(c, str) else [x.get("text", "") for x in c or [] if isinstance(x, dict) and x.get("type") == "text"]
        for t in texts:
            t = t.strip()
            if t and not t.startswith("<"): msgs.append(f"{m['type']}: {' '.join(t.split())[-width:]}")
    return msgs[-n:]


def transcripts(t, d, since):
    """The task's own session plus the newest conversation in its folder, if they moved since `since`."""
    out = []
    if sid := t.f.get("sid"): out += list(PROJECTS.glob(f"*/{sid}.jsonl"))
    slug = PROJECTS / re.sub(r"[^A-Za-z0-9]", "-", str(d))
    if slug.is_dir():
        newest = max(slug.glob("*.jsonl"), key=lambda p: p.stat().st_mtime, default=None)
        if newest and newest not in out: out.append(newest)
    return [p for p in out if p.stat().st_mtime >= since.timestamp()]


def evidence(t, since, latest, cache):
    """What happened in the task's folder since `since`, as prompt lines ([] = nothing to judge)."""
    d = resolve_dir(t.f.get("at"))
    if not d or d == ROOT or not d.is_dir(): return []
    if d not in cache:
        ev = [f"commit {c}" for c in git_log(d, since)] + [f"file {f}" for f in touched(d, since)]
        cache[d] = ev
    ev = list(cache[d])
    hp = task_handoff(t, latest)
    if hp and hp[0] >= since.timestamp():
        title, step = handoff_summary(hp[1])
        ev.append(f"handoff {dt.datetime.fromtimestamp(hp[0]):%d.%m %H:%M} {title} → next: {step}")
    for p in transcripts(t, d, since):
        ev += [f"session {dt.datetime.fromtimestamp(p.stat().st_mtime):%d.%m %H:%M} {m}" for m in transcript_tail(p)]
    return ev


def inbox_recent(since):
    """Phone notes (t inbox) written since `since`."""
    if not INBOX.exists(): return []
    out = []
    for block in INBOX.read_text(errors="ignore").split("\n## ")[1:]:
        head, _, body = block.partition("\n")
        try: when = dt.datetime.strptime(head[:16], "%Y-%m-%d %H:%M")
        except ValueError: continue
        if when >= since: out.append(f"{when:%d.%m %H:%M} {' '.join(body.split())}")
    return out


def check_prompt(rows, notes):
    lines = ["You check a to-do list against evidence of recent work. For each task decide:",
             "done = the evidence shows the task's OUTCOME is reached (sent, posted, submitted, merged, ordered, finished).",
             "progress = work happened for this task but the outcome is not reached yet (a draft is not 'sent').",
             "none = the evidence is about something else. Several tasks share a folder: judge only evidence that matches this task.",
             'Answer with JSON only: {"tasks": [{"id": "...", "verdict": "done|progress|none", "confidence": 0.0-1.0,',
             '"why": "max 15 words, cite the evidence", "next": "next concrete step if progress, else empty"}]}',
             f"Now: {now:%a %d.%m.%Y %H:%M}."]
    if notes: lines += ["", "Notes Martin sent from his phone (apply to any task):"] + [f"- {n}" for n in notes]
    for t, ev in rows:
        lines += ["", f"### [{t.id}] {t.text}", f"due: {t.f.get('due', '-')} · folder: {t.f.get('at', '-')}"]
        if t.next: lines.append(f"current next step: {t.next}")
        lines += ["evidence:"] + [f"- {e}" for e in ev or ["(only the phone notes above)"]]
    return "\n".join(lines)


def slm(prompt, timeout=180):
    """Ask the small model. TYAT_SLM=claude:haiku (default, headless Claude Code, no hooks/MCP/tools)
    or ollama:<model> (local, http://localhost:11434). Returns the raw text answer."""
    kind, _, model = os.environ.get("TYAT_SLM", "claude:haiku").partition(":")
    if kind == "ollama":
        import urllib.request
        body = json.dumps({"model": model, "prompt": prompt, "stream": False, "format": "json", "options": {"temperature": 0}}).encode()
        req = urllib.request.Request("http://localhost:11434/api/generate", data=body, headers={"content-type": "application/json"})
        with urllib.request.urlopen(req, timeout=timeout) as r: return json.loads(r.read())["response"]
    exe = shutil.which("claude") or str(HOME / ".local/bin/claude")
    r = subprocess.run([exe, "-p", "--model", model or "haiku", "--no-session-persistence", "--setting-sources", "",
                        "--strict-mcp-config", "--tools", ""], input=prompt, capture_output=True, text=True,
                       timeout=timeout, cwd=str(Path(os.environ.get("TMPDIR", "/tmp"))))
    if r.returncode: raise OSError(f"claude -p failed: {(r.stderr or r.stdout).strip()[:200]}")
    return r.stdout


def parse_verdicts(text):
    """{id: verdict dict} from the model's answer; tolerates code fences and chatter around the JSON."""
    a, b = text.find("{"), text.rfind("}")
    try: data = json.loads(text[a:b + 1]) if a >= 0 else {}
    except ValueError: return {}
    rows = data.get("tasks", []) if isinstance(data, dict) else []
    out = {}
    for r in rows:
        if not isinstance(r, dict) or r.get("verdict") not in ("done", "progress", "none"): continue
        try: conf = max(0.0, min(1.0, float(r.get("confidence", 0))))
        except (TypeError, ValueError): conf = 0.0
        out[str(r.get("id"))] = {"verdict": r["verdict"], "confidence": conf, "why": str(r.get("why", ""))[:160],
                                 "next": str(r.get("next", ""))[:160]}
    return out


def replan(tasks, g, keep=()):
    """{id: new due} for every late open task: its slot in the blocks of the next 3 days (rules, no model).
    Late tasks that find no room keep their date and come back as 'no room'."""
    pinned = {t.id for t in tasks if fixed(t)}  # appointments: nobody moves them, a missed one is a question
    items = [i for i in page_items([t for t in tasks if t.id not in keep], handoff_map()) if not i.get("stale")]
    late = {t.id for t in tasks if not t.done and t.due and t.due <= now and t.id not in keep and t.id not in pinned}
    by = {t.id: t for t in tasks}
    blocks, _ = schedule(items, g, horizon=72)
    moves = {}
    for start, _kind, its in blocks:
        at = start
        for i in its:
            slot = at + dt.timedelta(minutes=-at.minute % 5)
            if i["kind"] == "task" and i["id"] in late and not (deadline(by[i["id"]]) and slot > deadline(by[i["id"]])):
                moves[i["id"]] = slot
            at += dt.timedelta(minutes=i["mins"])
    return moves, sorted(late - set(moves))


def missed(tasks, keep=()):
    """Fixed appointments whose time has passed: ask whether they happened, never reschedule them."""
    return [t.id for t in tasks if not t.done and fixed(t) and t.due and t.due <= now and t.id not in keep]


def check(tasks, ask=None, since=None):
    """Verdicts for open tasks with fresh evidence; unchanged evidence reuses the cached verdict.
    Returns ({id: verdict}, asked count)."""
    since = since or now - dt.timedelta(hours=CHECK_HOURS)
    try: cache = json.loads(CHECK_CACHE.read_text())
    except (OSError, ValueError): cache = {}
    notes, latest, dirs = inbox_recent(since), handoff_map(), {}
    rows, verdicts = [], {}
    for t in tasks:
        if t.done: continue
        ev = evidence(t, since, latest, dirs)
        if not ev and not notes: continue
        h = hashlib.sha1("\n".join([t.text, *notes, *ev]).encode()).hexdigest()
        if cache.get(t.id, {}).get("h") == h: verdicts[t.id] = cache[t.id]["v"]
        else: rows.append((t, ev, h))
    if rows:
        got = parse_verdicts((ask or slm)(check_prompt([(t, ev) for t, ev, _ in rows], notes)))
        for t, _, h in rows:
            if t.id in got: verdicts[t.id] = got[t.id]; cache[t.id] = {"h": h, "v": got[t.id]}
    open_ids = {t.id for t in tasks if not t.done}
    CHECK_CACHE.write_text(json.dumps({k: v for k, v in cache.items() if k in open_ids}, indent=1))
    return verdicts, len(rows)


def check_cmd(args):
    """t check [--apply] [--auto]: --apply marks confident 'done' verdicts and moves late tasks into free slots;
    --auto = --apply + a notification instead of output (run by the notifier at block starts)."""
    auto = "--auto" in args
    apply = auto or "--apply" in args
    head, tasks = load()
    try: verdicts, asked = check(tasks)
    except (OSError, subprocess.TimeoutExpired) as e:
        if auto: return notify("🌱 tyat · check failed", str(e)[:120])
        sys.exit(f"t check: model call failed ({e})")
    by_id = {t.id: t for t in tasks if not t.done}
    done = [i for i, v in verdicts.items() if v["verdict"] == "done" and v["confidence"] >= CHECK_MIN and i in by_id]
    ask = [i for i in done if needs_me(by_id[i])] if auto else []  # ask first: only Marty closes his own steps
    done = [i for i in done if i not in ask]
    moves, stuck = replan(tasks, rhythm(), keep=done)
    gone = missed(tasks, keep=done)
    log = []
    if not auto:
        print(bold("🔍 CHECK") + dim(f"  ({os.environ.get('TYAT_SLM', 'claude:haiku')} · {len(verdicts)} tasks with activity, "
                                    f"{asked} re-asked, last {CHECK_HOURS}h)"))
        for i, v in sorted(verdicts.items(), key=lambda kv: ({"done": 0, "progress": 1}.get(kv[1]["verdict"], 2), kv[0])):
            if i not in by_id or v["verdict"] == "none": continue
            mark = grn("✓ done    ") if i in done else yel("? done    ") if v["verdict"] == "done" else cyan("… progress")
            info = f"{v['confidence']:.2f} · {v['why']}"
            print(f"  {mark} [{i}] {by_id[i].text[:60]}  {dim(info)}")
            if v["verdict"] == "progress" and v["next"]: print(f"               {dim('→ ' + v['next'])}")
        for i, d in sorted(moves.items(), key=lambda kv: kv[1]):
            print(f"  {cyan('↻ move    ')} [{i}] {by_id[i].text[:60]}  {dim(fmt_due(by_id[i].due) + ' → ')}{fmt_due(d)}")
        for i in stuck: print(f"  {red('⚠ no room ')} [{i}] {by_id[i].text[:60]}  {dim('cut, delegate or snooze by hand')}")
        for i in gone: print(f"  {yel('? missed  ')} [{i}] {by_id[i].text[:60]}  {dim('appointment passed: did it happen? t done / t snooze')}")
        if not apply and (done or moves): print(dim("  t check --apply  marks the ✓ and makes the ↻ moves"))
    if apply:
        for i in done:
            t = by_id[i]; t.done = True; t.f["done"] = now.isoformat(timespec="minutes")
            t.notes.append(f"auto-check: {verdicts[i]['why']}"); log.append(f"done [{i}] {t.text} — {verdicts[i]['why']}")
        for i, d in moves.items():
            log.append(f"move [{i}] {by_id[i].f.get('due')} → {d.isoformat(timespec='minutes')}")
            by_id[i].f["due"] = d.isoformat(timespec="minutes")
        if log:
            save(head, tasks)
            with CHECK_LOG.open("a") as f: f.write("".join(f"{now:%Y-%m-%d %H:%M} {x}\n" for x in log))
        if auto and ask:
            notify(f"🌱 tyat · erledigt? {len(ask)}", " · ".join(f"[{i}] {by_id[i].text[:40]}" for i in ask)[:180] + " → abhaken")
        if auto and (done or moves or stuck):
            notify(f"🌱 tyat · check: {len(done)} done, {len(moves)} moved" + (f", {len(stuck)} no room" if stuck else ""),
                   " · ".join([f"✓{i}" for i in done] + [f"↻{i} {fmt_due(d)}" for i, d in moves.items()])[:180])
        elif not auto: print(grn(f"  applied: {len(done)} done, {len(moves)} moved") + dim(f"  (log: {CHECK_LOG})"))


def notify(title, msg):
    msg, title = msg.replace('"', "'"), title.replace('"', "'")
    subprocess.run(["osascript", "-e", f'display notification "{msg}" with title "{title}" sound name "Glass"'])


def notify_pass():
    st = state()
    seen = st.setdefault("seen", {})
    _, tasks = load()
    for t in tasks:
        if t.done or not t.due or t.due > now: continue
        key = f"task:{t.id}:{t.f['due']}"
        if key not in seen:
            notify(f"🌱 tyat · ⏰ [{t.id}] due", f"{t.text} — {t.f.get('at', '')}  ·  t go {t.id}")
            seen[key] = now.isoformat()
    for s in sessions():
        if s["status"] in ON_YOU and s["since"] >= WAIT_ALERT_MIN * 60:
            key = f"sess:{s['sid']}:{s['status']}:{s['changed']}"
            if key not in seen:
                notify(f"🌱 tyat · ⏳ {s['who']} {ON_YOU[s['status']]} · {ago(s['since'])}", short(s["cwd"]))
                seen[key] = now.isoformat()
    g = rhythm()
    for key, (h, m), title, msg in (("sport", (g["sport"][0], 0), "🏃 Sport time", "Laptop zu. Tasks warten, der Block nicht."),
                                    ("stop", g["stop"], "🌙 Schluss für heute", "Handoff schreiben, t next setzen, schlafen.")):
        at = now.replace(hour=h, minute=m)
        k = f"{key}:{now:%Y-%m-%d}"
        if at <= now < at + dt.timedelta(minutes=15) and k not in seen:
            notify(f"🌱 tyat · {title}", msg); seen[k] = now.isoformat()
    if os.environ.get("TYAT_AUTOCHECK", "0") == "1":  # opt-in until replan() respects appointments + business hours
        for key, (h, m) in (("prep", (g["prep"][0], 0)), ("do", (g["do"][0], 0)), ("stop", g["stop"])):
            at, k = now.replace(hour=h, minute=m), f"check-{key}:{now:%Y-%m-%d}"
            if at <= now < at + dt.timedelta(minutes=15) and k not in seen:
                with (APP / ".notify.log").open("a") as err:
                    subprocess.Popen([sys.executable, str(APP / "tyat"), "check", "--auto"], stdout=subprocess.DEVNULL,
                                     stderr=err, start_new_session=True)
                seen[k] = now.isoformat()
    if (APP / ".plan-key").exists() and os.environ.get("TYAT_TICKSYNC", "1") == "1":
        try:
            for line in ticks_sync(quiet=True): notify("🌱 tyat · vom Handy", re.sub(r"\x1b\[[0-9;]*m", "", line))
        except SystemExit as e: print(f"tick sync: {e}", file=sys.stderr)  # offline: next pass retries
        st = state() | {"seen": seen}
    cutoff = (now - dt.timedelta(days=3)).isoformat()
    st["seen"] = {k: v for k, v in seen.items() if v >= cutoff}
    STATE.write_text(json.dumps(st, indent=1))


LABEL = "dev.tyat.notify"
PLIST = HOME / f"Library/LaunchAgents/{LABEL}.plist"
OLD_PLISTS = [HOME / "Library/LaunchAgents/de.marty.t-notify.plist", HOME / "Library/LaunchAgents/dev.tend.notify.plist"]


def install():
    for name in ("tyat", "t"):
        link = HOME / ".local/bin" / name
        if link.is_symlink() or not link.exists():
            if link.is_symlink(): link.unlink()
            link.symlink_to(APP / "tyat"); print(f"linked {link} → {APP / 'tyat'}")
        else: print(f"{link} exists and is not a symlink — left alone")
    PLIST.write_text(f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>{LABEL}</string>
  <key>ProgramArguments</key><array><string>{sys.executable}</string><string>{APP / 'tyat'}</string><string>notify</string></array>
  <key>StartInterval</key><integer>120</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardErrorPath</key><string>{APP / '.notify.log'}</string>
</dict></plist>
""")
    for old in OLD_PLISTS + [PLIST]:
        if old.exists():
            subprocess.run(["launchctl", "bootout", f"gui/{os.getuid()}", str(old)], capture_output=True)
            if old != PLIST: old.unlink()
    subprocess.run(["launchctl", "bootstrap", f"gui/{os.getuid()}", str(PLIST)], check=True)
    print(f"notifier loaded: {PLIST} (every 2 min; uninstall: launchctl bootout gui/{os.getuid()} {PLIST})")


# ── cli ───────────────────────────────────────────────────────────────────────
COMMANDS = {"add", "go", "done", "next", "snooze", "rm", "edit", "notify", "install", "ls", "here", "help",
            "now", "open", "recent", "handoffs", "page", "report", "inbox", "check", "sync", "me", "fix", "dl"}


def main(argv):
    if not argv: return interactive()
    cmd, args = argv[0], argv[1:]
    if cmd.isdigit(): return jump(ordered_sessions(), int(cmd))
    if cmd in ("ls",): return board()
    if cmd == "now": return now_cmd()
    if cmd in ("open", "o"): return open_cmd(args)
    if cmd in ("recent", "r"): return recent_cmd(args)
    if cmd in ("handoffs", "h"): return handoffs_cmd(args)
    if cmd in ("here", "."): return board(Path.cwd())
    if cmd in ("help", "-h", "--help"): return print(__doc__)
    if cmd in ("version", "-V", "--version"): return print(f"tyat {__version__}")
    if cmd in ("page", "html"): return page_cmd(args)
    if cmd == "report": return report_cmd()
    if cmd == "inbox": return inbox_cmd(args)
    if cmd == "sync": return ticks_sync()
    if cmd == "me": return me_cmd(args)
    if cmd == "check": return check_cmd(args)
    if cmd == "edit": return os.execvp(os.environ.get("EDITOR", "nano"), [os.environ.get("EDITOR", "nano"), str(TASKS)])
    if cmd == "notify": return notify_pass()
    if cmd == "install": return install()
    if cmd not in ("add", "go", "done", "next", "snooze", "rm", "fix", "dl"): sys.exit(f"t: unknown command '{cmd}' (t help for usage)")
    head, tasks = load()
    if cmd == "add":
        at = next((a[1:] for a in args if a.startswith("@")), None)
        pri = max((len(a) for a in args if re.fullmatch(r"!{1,3}", a)), default=0)
        extra = dict(a.split(":", 1) for a in args if re.fullmatch(r"(est:\d+[mh]|reach:[1-5]|me:[01]|fix:[01])", a))
        due, words = parse_when([a for a in args if not a.startswith("@") and not re.fullmatch(r"!{1,3}", a)
                                 and not re.fullmatch(r"(est|reach|me|fix):\S+", a)])
        if not words: sys.exit("usage: t add <text> [@folder] [when]")
        if at is None:
            cwd = Path.cwd()
            at = short(cwd) if cwd != ROOT else None
        elif at in (".", "here"): at = short(Path.cwd())
        t = Task(False, " ".join(words))
        t.text = " ".join(words)
        t.f = {k: v for k, v in (("at", at), ("due", due and due.isoformat(timespec="minutes")), ("pri", pri and str(pri)), ("id", new_id(tasks))) if v} | extra
        if at and not resolve_dir(at).is_dir(): print(yel(f"note: folder {resolve_dir(at)} does not exist yet"))
        tasks.append(t); save(head, tasks)
        return print(f"+ [{t.id}] {t.text}  {fmt_due(due)}  {dim('@' + at) if at else ''}")
    if cmd == "go":
        if not args: sys.exit("usage: t go <id> [claude|codex|kit:<name>] [--new]")
        return go(args[0], args[1:])
    if not args: sys.exit(f"usage: t {cmd} <id> …")
    t = find(tasks, args[0])
    if cmd == "done":
        t.done = True; t.f["done"] = now.isoformat(timespec="minutes"); msg = f"✓ [{t.id}] {t.text}"
    elif cmd == "next":
        if not args[1:]: sys.exit("usage: t next <id> <next step>")
        t.notes.append("next: " + " ".join(args[1:])); msg = f"→ [{t.id}] next: {' '.join(args[1:])}"
    elif cmd == "snooze":
        due, _ = parse_when(args[1:] or ["1h"])
        if due is None: sys.exit(f"t: can't read a time in {' '.join(args[1:])!r} (e.g. 2h, tomorrow, fri 14:00)")
        t.f["due"] = due.isoformat(timespec="minutes"); msg = f"💤 [{t.id}] → {fmt_due(due)}"
        if deadline(t) and due > deadline(t): msg += red(f"  ⚠ after its deadline {fmt_due(deadline(t))}")
    elif cmd == "fix":
        t.f["fix"] = "0" if args[1:] == ["0"] else "1"
        msg = f"{'📌 fixed' if t.f['fix'] == '1' else '↻ movable'} [{t.id}] {t.text}"
    elif cmd == "dl":
        if args[1:] == ["-"]: t.f.pop("dl", None); msg = f"[{t.id}] no deadline"
        else:
            d, _ = parse_when(args[1:])
            if d is None: sys.exit("usage: t dl <id> <when> (or - to clear)")
            t.f["dl"] = d.isoformat(timespec="minutes"); msg = f"⛳ [{t.id}] deadline {fmt_due(d)}"
    elif cmd == "rm":
        tasks.remove(t); msg = f"✗ [{t.id}] removed"
    save(head, tasks)
    print(msg)


