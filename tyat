def page_html(items, ss, loose, windows):
    E = html.escape
    learned_prep, learned_exec, counts = windows
    g = rhythm()
    (prep_h, prep_n), (exec_h, exec_n), (sport_h, sport_n), stop = g["prep"], g["do"], g["sport"], g["stop"]
    night = night_share(counts, stop)
    live = [i for i in items if not i.get("stale")]
    peak = max(counts) or 1
    for i in live:
        h, n = (prep_h, prep_n) if i["mode"] == "prep" else (exec_h, exec_n)
        i["slot"] = next_slot(h, n)
        if i["due"] and i["due"] < i["slot"]: i["slot"] = now  # the window comes too late: do it now
        i["offhours"] = i["kind"] == "post" and i["due"] and not (exec_h <= i["due"].hour < exec_h + exec_n)

    timeline, overflow = schedule(live, g)
    for start, _, rows in timeline:
        for i in rows: i["slot"] = start
    used = sum(i["mins"] for _, _, rows in timeline for i in rows)
    quick = [i for i in live if i["est"] and i["mins"] <= 15]
    stale = [i for i in items if i.get("stale")]
    late = sum(1 for i in live if i["due"] and i["due"] <= now)

    def due(i):
        if not i["due"]: return '<span class="due">no date</span>'
        u = urgency(i["due"])
        return f'<span class="due u{u}">{E(ANSI.sub("", fmt_due(i["due"])))}</span>'

    def card(i, n=None):
        hand = ""
        if i["hand"] and i["hand"][1]:
            hand = f'<p class="hand">📄 {ago(now.timestamp() - i["hand"][0])} ago · {E(i["hand"][1][:180])}</p>'
        nxt = f'<p class="next">→ {E(i["next"][:200])}</p>' if i["next"] else ""
        badge = f'<span class="st {E(i["status"])}">{E(i["status"])}</span>' if i["kind"] == "post" else ""
        when = "now" if i["slot"] == now else ANSI.sub("", fmt_due(i["slot"]))
        slot = f'<p class="slot {i["mode"]}">{"🌙 prep" if i["mode"] == "prep" else "☀️ do"} · {E(when)}</p>'
        if i["offhours"]:
            slot += (f'<p class="warn">⚠ {i["due"]:%H:%M} is outside your do block: queue it in the scheduler '
                     f'during the prep block the night before, or move the slot to {exec_h}:30</p>')
        rank = f'<span class="rank">{n}</span>' if n else ""
        return (f'<li class="card {i["kind"]}">{rank}<div class="meta"><b class="id">{E(i["id"])}</b>{due(i)}{badge}'
