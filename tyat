def de_when(d):
    if d.date() == now.date(): return d.strftime("%H:%M")
    if d.date() == now.date() + dt.timedelta(1): return d.strftime("morgen %H:%M")
    return f"{WD[d.weekday()]} {d:%H:%M}"


def speakable(s):
    """Text an ElevenLabs voice reads well: no emoji, ids, paths or markup."""
    s = re.sub(r"<[^>]*>", "", s)
    s = re.sub("[\U0001F000-\U0001FAFF\u2600-\u27BF\uFE0F]", "", s)
    s = re.sub(r"[`*_#>|\[\]{}]|\S+/\S+", " ", s)
    return re.sub(r"\s+", " ", s).strip(" .:-")


def voice_text(kind, rows, stop):
    if kind == "sport": return "Sportzeit. Laptop zu, die Aufgaben warten."
    if kind == "stop": return f"Es ist {stop[0]} Uhr{f' {stop[1]}' if stop[1] else ''}. Handoff schreiben, t next eintragen, Laptop zu. Gute Nacht."
    head = {"now": "Jetzt zuerst das mit Deadline.", "prep": "Nacht-Block.", "deep": "Deep-Block.",
            "do": "Do-Block, alles vom Handy."}[kind]
    parts = [f"{NTH[n]}: {speakable(i['title'])}" + (" — mit Deadline" if i["due"] else "") for n, i in enumerate(rows[:4])]
    more = [f"Und {len(rows) - 4} weitere, siehe Liste."] if len(rows) > 4 else []  # long briefings cost characters
    return " ".join([head, *(p + "." for p in parts), *more])


def window(h, m, mins):
    """(start, end) of the daily window h:m + mins that is running now (start clipped to now) or comes next."""
    for day in (-1, 0, 1):
        start = (now + dt.timedelta(days=day)).replace(hour=h, minute=m)
        end = start + dt.timedelta(minutes=mins)
        if end > now: return max(start, now), end
    raise AssertionError("a daily window always comes back within a day")


def phone_sections(items, g):
    """[(key, kind, start, end, rows)] for the next ~30h: the scheduled work blocks plus sport and the stop."""
    timeline, overflow = schedule(items, g)
    # the running block's own items come first, rush work right after them (that is what schedule() promised)
    first = sum(i["mins"] for start, kind, rows in timeline if kind != "now" and start == now for i in rows)
    out = []
    for start, kind, rows in timeline:
        if not rows: continue
        if kind == "now":
            start = now + dt.timedelta(minutes=first)
            out.append((kind, start, start + dt.timedelta(minutes=sum(i["mins"] for i in rows)), rows))
        else: out.append((kind, start, None, rows))
    out.append(("sport", *window(g["sport"][0], 0, g["sport"][1] * 60), []))
    h, m = g["stop"]
    out.append(("stop", *window(h, m, ((5 - h) % 24) * 60 - m), []))
    secs = []
    for kind, start, end, rows in sorted(out, key=lambda x: x[1]):
        if end is None:  # a work block ends where the rhythm says
            h, n = {"prep": g["prep"], "do": g["do"]}.get(kind) or next(w for w in g["deep"] if w[0] <= start.hour < w[0] + w[1])
            began = start.replace(hour=h, minute=0)
            if began > start: began -= dt.timedelta(days=1)  # we are inside a block that began yesterday
            end = began + dt.timedelta(hours=n)
        secs.append((f"{kind}-{start:%d%H%M}", kind, start, end, rows))
    return secs, overflow


