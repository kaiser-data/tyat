def page_cmd(args):
    _, tasks = load()
    latest = handoff_map()
    covered = {resolve_dir(t.f["at"]) for t in tasks if not t.done and "at" in t.f}
    fresh = now.timestamp() - 3 * 86400
    loose = [(k, m, handoff_summary(p)[1]) for k, (m, p) in sorted(latest.items(), key=lambda kv: -kv[1][0])
             if m >= fresh and k not in covered and not any(c and c in k.parents for c in covered)]
    items = page_items(tasks, latest)
    PAGE.write_text(page_html(items, ordered_sessions(), loose, activity_windows()))
    print(f"wrote {PAGE}")
    if "--publish" in args: return publish(items, args)
    if "--no-open" not in args and sys.platform == "darwin": subprocess.run(["open", str(PAGE)])


