# ── tasks file ────────────────────────────────────────────────────────────────
# - [ ] Review stars report @products/github-stars-analyzer due:2026-10-27T14:00 id:b via:claude sid:<uuid>
#   > next: check top 20 candidates
LINE = re.compile(r"^- \[( |x)\] (.*)$")
TOKEN = re.compile(r"(?:^|\s)(@\S+|(?:due|id|via|sid|done|pri|est|reach|me|fix|dl):\S+)")


class Task:
    def __init__(self, done, body):
        self.done, self.notes, self.f = done, [], {}
        for tok in TOKEN.findall(body):
            if tok.startswith("@"): self.f["at"] = tok[1:]
            else:
                k, v = tok.split(":", 1); self.f[k] = v
        self.text = TOKEN.sub("", body).strip()

    @property
    def id(self): return self.f.get("id", "?")
    @property
    def due(self):
        try: return dt.datetime.fromisoformat(self.f["due"])
        except (KeyError, ValueError): return None
    @property
    def pri(self):
        try: return int(self.f.get("pri", 0))
        except ValueError: return 0
    @property
    def next(self):
        for n in reversed(self.notes):
            if n.startswith("next:"): return n[5:].strip()

    def line(self):
        parts = [f"- [{'x' if self.done else ' '}] {self.text}"]
        if "at" in self.f: parts.append("@" + self.f["at"])
        parts += [f"{k}:{self.f[k]}" for k in ("due", "dl", "pri", "est", "reach", "me", "fix", "id", "via", "sid", "done") if k in self.f]
        return " ".join(parts) + "".join(f"\n  > {n}" for n in self.notes)


def load():
    head, tasks = [], []
    if TASKS.exists():
        for raw in TASKS.read_text().splitlines():
            m = LINE.match(raw)
            if m: tasks.append(Task(m[1] == "x", m[2]))
            elif raw.startswith("  > ") and tasks: tasks[-1].notes.append(raw[4:])
            elif not tasks: head.append(raw)
    return head or ["# Tasks", "", "<!-- edited by `t`; hand edits welcome, one task per line -->", ""], tasks


def save(head, tasks):
    open_ = [t for t in tasks if not t.done]
    closed = [t for t in tasks if t.done][-200:]
    tmp = TASKS.with_name(TASKS.name + ".tmp")  # write-then-rename: a crash never leaves a half-written file
    tmp.write_text("\n".join(head + [t.line() for t in open_ + closed]) + "\n")
    os.replace(tmp, TASKS)


def find(tasks, tid):
    for t in tasks:
        if t.id == tid and not t.done: return t
    sys.exit(f"no open task '{tid}'")


def new_id(tasks):
    """Lowest free id. Ids finished today stay taken, so "af is done" never names a brand-new af the same evening."""
    used = {t.id for t in tasks if not t.done or t.f.get("done", "").startswith(now.date().isoformat())}
    n = 0
    while True:
        s, k = "", n
        while True:
            s = chr(97 + k % 26) + s; k = k // 26 - 1
            if k < 0: break
        if s not in used and s not in RESERVED: return s
        n += 1


def state():
    try: return json.loads(STATE.read_text())
    except (OSError, ValueError): return {}


# ── time parsing ──────────────────────────────────────────────────────────────
DAYS = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]


def parse_when(words):
    """Consume time words from a token list. Returns (datetime|None, leftover words)."""
    try: return _parse_when(words)
    except ValueError as e: sys.exit(f"t: invalid date/time in {' '.join(words)!r}: {e}")


def _parse_when(words):
    day, hm, rel, rest = None, None, None, []
    for w in words:
        lw = w.lower().rstrip(",")
        if lw in ("today", "heute"): day = now.date()
        elif lw in ("tomorrow", "tmrw", "morgen"): day = now.date() + dt.timedelta(1)
        elif lw in ("tonight", "abends"): day, hm = now.date(), (19, 0)
        elif lw[:3] in DAYS and lw in (lw[:3], DAYS_FULL[lw[:3]]):
            idx = DAYS.index(lw[:3])
            day = now.date() + dt.timedelta((idx - now.weekday() - 1) % 7 + 1)
        elif m := re.fullmatch(r"\+?(\d+)(m|min|h|d|w)", lw):
            n, u = int(m[1]), m[2]
            rel = {"m": dt.timedelta(minutes=n), "min": dt.timedelta(minutes=n), "h": dt.timedelta(hours=n),
                   "d": dt.timedelta(days=n), "w": dt.timedelta(weeks=n)}[u]
        elif m := re.fullmatch(r"(\d{1,2})[:.](\d{2})(h|uhr)?", lw): hm = (int(m[1]), int(m[2]))
        elif m := re.fullmatch(r"(\d{1,2})(am|pm|h|uhr)", lw):
            h = int(m[1]) % 12 + (12 if m[2] == "pm" else 0) if m[2] in ("am", "pm") else int(m[1]); hm = (h, 0)
        elif m := re.fullmatch(r"(\d{4})-(\d{2})-(\d{2})", lw): day = dt.date(int(m[1]), int(m[2]), int(m[3]))
        elif m := re.fullmatch(r"(\d{1,2})\.(\d{1,2})\.(\d{4})?", lw):
            d = dt.date(int(m[3] or now.year), int(m[2]), int(m[1]))
            day = d if d >= now.date() or m[3] else d.replace(year=now.year + 1)
        else: rest.append(w)
    if rel:
        base = now + rel
        if not hm and rel >= dt.timedelta(days=1): hm = (9, 0)
        return (base.replace(hour=hm[0], minute=hm[1]) if hm else base), rest
    if day is None and hm is None: return None, rest
    if day is None:
        day = now.date()
        if dt.datetime.combine(day, dt.time(*hm)) <= now: day += dt.timedelta(1)
    return dt.datetime.combine(day, dt.time(*(hm or (9, 0)))), rest


DAYS_FULL = dict(zip(DAYS, ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"], strict=True))


def fmt_due(d):
    if d is None: return dim("later")
    delta = d - now
    if delta.total_seconds() < 0:
        late = -delta
        s = f"{late.days}d" if late.days else f"{late.seconds // 3600}h" if late.seconds >= 3600 else f"{late.seconds // 60}m"
        return red(f"⚠ {s} late")
    if d.date() == now.date(): return yel(d.strftime("%H:%M"))
    if d.date() == now.date() + dt.timedelta(1): return d.strftime("tmrw %H:%M")
    if delta.days < 6: return d.strftime("%a %H:%M")
    return d.strftime("%d %b")


ANSI = re.compile(r"\033\[[0-9;]*m")
def pad(s, n, right=False):
    gap = " " * max(0, n - len(ANSI.sub("", s)))
    return gap + s if right else s + gap


def ago(secs):
    secs = max(0, int(secs))
    if secs < 60: return f"{secs}s"
    if secs < 3600: return f"{secs // 60}m"
    if secs < 86400: return f"{secs // 3600}h{secs % 3600 // 60:02d}"
    return f"{secs // 86400}d"


# ── folders ───────────────────────────────────────────────────────────────────
def short(p):
    p = Path(p)
    try: return str(p.relative_to(ROOT))
    except ValueError: return str(p).replace(str(HOME), "~", 1)


def clip_at(at):
    parts = at.split("/")
    return at if len(at) <= 40 or len(parts) <= 2 else "…/" + "/".join(parts[-2:])


def resolve_dir(at):
    if not at: return None
    p = Path(os.path.expanduser(at))
    return p if p.is_absolute() else ROOT / p


# ── live sessions ─────────────────────────────────────────────────────────────
def alive(pid):
    try: os.kill(pid, 0); return True
    except ProcessLookupError: return False
    except PermissionError: return True


def sessions():
    out, nowms = [], dt.datetime.now().timestamp() * 1000
    for f in SESS_DIR.glob("*.json"):
        try: s = json.loads(f.read_text())
        except (OSError, ValueError): continue
        if s.get("kind") != "interactive" or not alive(s.get("pid", 0)): continue
        if "/.claude-mem/" in s.get("cwd", ""): continue
        st = s.get("status", "?")
        since = (nowms - s.get("statusUpdatedAt", s.get("startedAt", nowms))) / 1000
        out.append(dict(pid=s["pid"], who="claude", cwd=s.get("cwd", ""), status=st, since=since,
                        sid=s.get("sessionId"), name=s.get("name", ""), changed=s.get("statusUpdatedAt")))
    try:
        ps = subprocess.run(["ps", "-axo", "pid=,ppid=,etime=,args="], capture_output=True, text=True).stdout
    except OSError: ps = ""
    found = {}
    for row in ps.splitlines():
        parts = row.split(None, 3)
        if len(parts) < 4: continue
        pid, ppid, etime, args = int(parts[0]), int(parts[1]), parts[2], parts[3]
        argv = args.split()
        names = [os.path.basename(a) for a in argv[:2]]
        who = next((n for n in names if n in OTHER_AGENTS), None)
        if not who or (argv[1:2] and argv[1] in ("exec", "e", "app-server", "mcp", "login")): continue
        found[pid] = dict(pid=pid, ppid=ppid, who=who, etime=etime)
    found = {p: v for p, v in found.items() if v["ppid"] not in found}  # drop wrapper→binary children
    if found:
        lo = subprocess.run(["lsof", "-a", "-d", "cwd", "-Fpn", "-p", ",".join(map(str, found))],
                            capture_output=True, text=True).stdout
        cur = None
        for ln in lo.splitlines():
            if ln.startswith("p"): cur = int(ln[1:])
            elif ln.startswith("n") and cur in found: found[cur]["cwd"] = ln[1:]
        for v in found.values():
            out.append(dict(pid=v["pid"], who=v["who"], cwd=v.get("cwd", "?"), status="running",
                            since=etime_secs(v["etime"]), sid=None, name=""))
    return out


def etime_secs(e):
    d, _, rest = e.rpartition("-")
    nums = [int(x) for x in rest.split(":")]
    while len(nums) < 3: nums.insert(0, 0)
    return int(d or 0) * 86400 + nums[0] * 3600 + nums[1] * 60 + nums[2]


ON_YOU = {"waiting": "needs you", "idle": "your turn"}


def ordered_sessions():
    ss = sessions()
    rank = {"waiting": 0, "idle": 1}
    return sorted(ss, key=lambda s: (rank.get(s["status"], 2), -s["since"] if s["status"] in rank else s["since"]))


# ── board ─────────────────────────────────────────────────────────────────────
def board(filter_dir=None):
    _, tasks = load()
    ss = ordered_sessions()
    by_sid = {t.f["sid"]: t for t in tasks if not t.done and "sid" in t.f}
    live_sids = {s["sid"] for s in ss if s["sid"]}
    if filter_dir:
        ss = [s for s in ss if s["cwd"].startswith(str(filter_dir))]
    waiting = [s for s in ss if s["status"] in ON_YOU]
    running = [s for s in ss if s["status"] not in ON_YOU]

    def srow(i, s):
        t = by_sid.get(s["sid"])
        tag = cyan(f" [{t.id}] {t.text[:40]}") if t else ""
        st = s["status"]
        label = (red if st == "waiting" else yel if st == "idle" else grn)(f"{ON_YOU.get(st, st):<9}")
        print(f"  {pad(bold(str(i)), 3, True)}  {s['who']:<7} {short(s['cwd'])[:44]:<44} {label} {ago(s['since']):>5}{tag}")

    i = 0
    if waiting:
        print(bold("⏳ ON YOU"))
        for s in waiting: i += 1; srow(i, s)
    if running:
        print(bold("🔄 RUNNING"))
        for s in running: i += 1; srow(i, s)
    if not ss: print(dim("no agent sessions running"))

    open_ = [t for t in tasks if not t.done]
    if filter_dir:
        open_ = [t for t in open_ if resolve_dir(t.f.get("at")) and str(resolve_dir(t.f["at"])).startswith(str(filter_dir))]
    far = dt.datetime.max
    open_.sort(key=lambda t: (t.due or far, -t.pri, t.id))
    print(bold("📋 TASKS") + dim(f"  ({len(open_)} open)"))
    if not open_: print(dim("  nothing — capture with: t add <text> @folder tomorrow 10:00"))
    limit = max(15, sum(1 for t in open_ if t.due and t.due <= now))
    shown = 0
    for t in open_[:limit]:
        shown += 1
        sess = ""
        if t.f.get("sid") in live_sids: sess = grn(" ● live")
        elif "sid" in t.f: sess = dim(" ↺ resumable")
        mark = red("!" * t.pri) + " " if t.pri else ""
        print(f"  {pad(bold(t.id), 3, True)}  {pad(fmt_due(t.due), 10)} {pad(mark + t.text[:46 - t.pri], 46)} {dim('@' + clip_at(t.f['at'])) if 'at' in t.f else ''}{sess}")
        if t.next: print(f"       {dim('→ ' + t.next[:90])}")
    if shown < len(open_): print(dim(f"  … {len(open_) - shown} more (t edit)"))
    return ss


def recommend(tasks, ss):
    """Everything worth doing now, best first: (rank, label, action)."""
    recs = []
    linked = {t.f["sid"]: t for t in tasks if not t.done and "sid" in t.f}
    for i, s in enumerate(ss, 1):
        t = linked.get(s["sid"])
        what = f"[{t.id}] {t.text}" if t else short(s["cwd"])
        if s["status"] == "waiting":
            recs.append(((0, -s["since"]), f"answer {s['who']} · {what} {red('needs you ' + ago(s['since']))}", ("jump", i)))
        elif s["status"] == "idle":
            recs.append(((2 if t else 4, -s["since"]), f"continue {s['who']} · {what} {yel('your turn ' + ago(s['since']))}", ("jump", i)))
    live = {s["sid"] for s in ss if s["sid"]}
    for t in tasks:
        if t.done or t.f.get("sid") in live: continue
        where = dim(" @" + t.f["at"]) if "at" in t.f else ""
        if t.due and t.due <= now: rank = (1, -t.pri, t.due.timestamp())
        elif t.due and t.due <= now + dt.timedelta(hours=3): rank = (3, t.due.timestamp(), 0)
        elif t.due is None and t.pri: rank = (5, -t.pri, 0)
        elif t.due and t.due.date() == now.date(): rank = (6, t.due.timestamp(), 0)
        elif t.due is None: rank = (7, 0, 0)
        else: continue
        recs.append((rank, f"start [{t.id}] {t.text} {fmt_due(t.due)}{where}", ("go", t.id)))
    recs.sort(key=lambda r: r[0])
    return recs


def do(action, ss):
    kind, arg = action
    return jump(ss, arg) if kind == "jump" else go(arg, [])


def now_cmd():
    _, tasks = load()
    ss = ordered_sessions()
    recs = recommend(tasks, ss)
    if not recs: return print("nothing to do — inbox zero 🎉")
    print(bold("▶ ") + recs[0][1])
    do(recs[0][2], ss)


def interactive():
    ss = board()
    _, tasks = load()
    recs = recommend(tasks, ss)
    if recs:
        print("\n" + bold("▶ NEXT  ") + recs[0][1])
        for r in recs[1:3]: print(dim("  then  ") + r[1])
    if not sys.stdin.isatty(): return
    print(dim("\n  ⏎ do next · 1-9 jump · a-z start task · o open folder · r recent · + add · x a done · s a 2h · q quit"))
    try: cmd = input("› ").strip()
    except (EOFError, KeyboardInterrupt): print(); return
    if cmd == "q": return
    if not cmd: return do(recs[0][2], ss) if recs else None
    if cmd.startswith("+"): return main(["add"] + cmd[1:].split())
    if cmd in ("o", "r") or cmd.split()[0] in ("o", "r"):
        return main([{"o": "open", "r": "recent"}[cmd.split()[0]]] + cmd.split()[1:])
    if cmd.isdigit(): return jump(ss, int(cmd))
    parts = cmd.split()
    alias = {"x": "done", "s": "snooze", "n": "next"}
    if parts[0] in alias: return main([alias[parts[0]]] + parts[1:])
    if re.fullmatch(r"[a-z]{1,2}", parts[0]) and parts[0] not in COMMANDS: return main(["go"] + parts)
    main(parts)


# ── actions ───────────────────────────────────────────────────────────────────
def jump(ss, n):
    if not 1 <= n <= len(ss): sys.exit(f"no session {n}")
    s = ss[n - 1]
    tty = subprocess.run(["ps", "-o", "tty=", "-p", str(s["pid"])], capture_output=True, text=True).stdout.strip()
    script = f'''tell application "iTerm2"
  repeat with w in windows
    repeat with t in tabs of w
      repeat with s in sessions of t
        if tty of s is "/dev/{tty}" then
          select w
          tell t to select
          tell s to select
          activate
          return "ok"
        end if
      end repeat
    end repeat
  end repeat
end tell'''
    r = subprocess.run(["osascript", "-e", script], capture_output=True, text=True) if tty and tty != "??" else None
    if r and r.stdout.strip() == "ok": return
    print(f"{s['who']} pid {s['pid']} · tty {tty or '?'} · {s['cwd']}")
    print(dim("couldn't focus the tab (not an iTerm tab, or inside herdr) — cwd above"))


def go(tid, rest):
    head, tasks = load()
    t = find(tasks, tid)
    fresh = "--new" in rest
    ask = "?" in rest
    rest = [r for r in rest if r not in ("--new", "?")]
    folder = resolve_dir(t.f.get("at")) or Path.cwd()
    if not folder.is_dir(): sys.exit(f"folder missing: {folder}  (fix @path with t edit)")

    sid = t.f.get("sid")
    if sid and not fresh:
        ss = ordered_sessions()
        live = [i for i, s in enumerate(ss, 1) if s["sid"] == sid]
        if live:
            print(f"task {tid} already has a live session — jumping")
            return jump(ss, live[0])
    if rest: via, resume = rest[0], None
    elif sid and not fresh and not ask and session_exists(sid): via, resume = t.f.get("via", "claude"), sid
    else:
        via, resume = choose(folder, t.text, preferred=None if ask else t.f.get("via"), task=t)
        if via is None: return

    notes = "\n".join(t.notes)
    ho = latest_handoff(folder)
    prompt = (f"Task [{tid}]: {t.text}\n" + (f"Notes:\n{notes}\n" if notes else "") +
              (f"Latest handoff: {ho} — read it first.\n" if ho else "") +
              f"\nWhen you stop — finished or paused — record it so nothing gets lost: run "
              f"`t done {tid}` if it is complete, otherwise `t next {tid} \"<one-line next step>\"`.")
    name = f"{tid}-" + re.sub(r"[^a-z0-9]+", "-", t.text.lower())[:30].strip("-")
    argv, new_sid = build_argv(via, prompt, name, resume)
    if new_sid: t.f["sid"] = new_sid
    t.f["via"] = via
    t.notes.append(f"{'resumed' if resume else 'started'} {now:%Y-%m-%d %H:%M} via {via}")
    save(head, tasks)
    launch(folder, via, argv)


def build_argv(via, prompt, name, resume=None):
    """Command line for an assistant. Returns (argv, claude session id or None)."""
    if via == "claude" or via.startswith("kit:"):
        base = ["claude"] if via == "claude" else [KIT, via[4:]]
        if resume: return base + ["--resume", resume], resume
        sid = str(uuid.uuid4())
        return base + ["--session-id", sid, "-n", name] + ([prompt] if prompt else []), sid
    if via == "codex": return ["codex"] + ([prompt] if prompt else []), None
    if via == "gemini": return ["gemini"] + (["-i", prompt] if prompt else []), None
    if prompt:
        subprocess.run(["pbcopy"], input=prompt, text=True)
        print(dim("prompt copied to clipboard — paste it in"))
    return [via], None


def launch(folder, via, argv):
    if not sys.stdout.isatty():  # called from an agent or a script: exec here would run the session headless
        cmd = f"cd {shlex.quote(str(folder))} && {shlex.join(argv)}"
        esc = cmd.replace("\\", "\\\\").replace('"', '\\"')
        subprocess.run(["osascript", "-e", f'tell application "iTerm2"\n  activate\n'
                        f'  tell (create window with default profile) to tell current session to write text "{esc}"\nend tell'],
                       capture_output=True, text=True)
        return print(f"→ opened in a new iTerm window: {short(folder)} · {via}")
    os.chdir(folder)
    print(dim(f"→ {short(folder)} · {via}"), flush=True)
    os.execvp(argv[0], argv)


# ── choosing how to start ─────────────────────────────────────────────────────
def key(prompt):
    import termios
    import tty as tty_mod
    print(prompt, end="", flush=True)
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty_mod.setcbreak(fd)
        ch = sys.stdin.read(1)
    except KeyboardInterrupt: ch = "q"
    finally: termios.tcsetattr(fd, termios.TCSADRAIN, old)
    print()
    return ch


def kit_for(text, timeout=4):
    """kogitsune's kit selector (learned router is instant; cold path asks haiku)."""
    try:
        r = subprocess.run([KIT, "for", text], capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired): return None
    m = re.search(r"for: (\S+)", r.stderr)
    return m[1] if m else None


def history():
    """Recent Claude conversations, newest first: {sid, ts, cwd, last}."""
    rows = {}
    try: lines = HIST.read_text(errors="ignore").splitlines()[-6000:]
    except OSError: return []
    for line in lines:
        try: h = json.loads(line)
        except ValueError: continue
        sid, cwd = h.get("sessionId"), h.get("project", "")
        if not sid or "/private/tmp" in cwd or "/.claude-mem/" in cwd: continue
        r = rows.setdefault(sid, dict(sid=sid, cwd=cwd, last=""))
        r["ts"] = h.get("timestamp", 0) / 1000
        txt = " ".join(h.get("display", "").split())
        if txt and not txt.startswith("/"): r["last"] = txt
    return sorted(rows.values(), key=lambda r: -r["ts"])


def last_session(folder):
    for h in history():
        if h["cwd"] == str(folder) and session_exists(h["sid"]): return h


def choose(folder, text, preferred=None, task=None):
    """Ask how to start in `folder`. Returns (via, resume_sid) or (None, None) on cancel."""
    last = last_session(folder)
    kit = kit_for(text) if task else None
    opts = {"c": ("claude", None, "claude new"), "x": ("codex", None, "codex")}
    if kit: opts["k"] = (f"kit:{kit}", None, f"kit {kit}")
    if last: opts["r"] = ("claude", last["sid"], f"resume “{last['last'][:40]}” {ago(dt.datetime.now().timestamp() - last['ts'])} ago")
    if preferred and preferred not in ("claude", "codex") and not preferred.startswith("kit:"):
        opts["o"] = (preferred, None, preferred)
    default = ("k" if kit else "c") if task else ("r" if last and dt.datetime.now().timestamp() - last["ts"] < 86400 else "c")
    if preferred:
        default = next((k for k, v in opts.items() if v[0] == preferred and v[1] is None), default)
    print(bold(f"start in {short(folder)}") + (dim(f"  · kogitsune suggests kit {kit}") if kit else ""))
    print("  " + " · ".join(f"{bold(k)} {v[2]}" for k, v in opts.items()) + f" · {bold('q')} cancel")
    if not sys.stdin.isatty(): ch = ""
    else: ch = key(f"  ⏎ = {opts[default][2]} › ").strip().lower()
    if ch == "q": return None, None
    if ch == "k" and "k" not in opts:
        print(dim("asking kogitsune…")); kit = kit_for(text or folder.name, timeout=30)
        return (f"kit:{kit}", None) if kit else ("claude", None)
    v = opts.get(ch or default, opts[default])
    return v[0], v[1]


# ── handoffs ──────────────────────────────────────────────────────────────────
SKIP_DIRS = {"node_modules", ".git", "_archive", "archive", ".worktrees", ".venv", "venv", "dist", "build",
             "graphify-out", "__pycache__", ".next", "_backups"}
SUBDIRS = {"docs", "internal", "plans", "notes", ".superpowers", "sdd", "data"}


def handoff_files(root, max_age_days=None):
    cutoff = dt.datetime.now().timestamp() - max_age_days * 86400 if max_age_days else 0
    for dirpath, dirs, files in os.walk(root):
        dirs[:] = [d for d in dirs if d not in SKIP_DIRS and not d.endswith(".worktrees")]
        for f in files:
            if f.startswith("HANDOFF") and f.endswith(".md"):
                p = Path(dirpath) / f
                m = p.stat().st_mtime
                if m >= cutoff: yield p, m


def project_of(p):
    d = p.parent
    while d.name in SUBDIRS and d != ROOT: d = d.parent
    return d


def latest_handoff(folder):
    best = max(((m, p) for p, m in handoff_files(folder) if len(p.relative_to(folder).parts) <= 3), default=None)
    return best[1] if best else None


def handoff_summary(p):
    """(title, first next step) from a handoff file."""
    title, step, in_next = "", "", False
    for line in p.read_text(errors="ignore").splitlines():
        if not title and line.startswith("# "): title = line[2:].strip()
        if line.startswith("#"):
            in_next = bool(re.search(r"next|nächst|offen|open|pending", line, re.I))
            continue
        if in_next and not step and line.strip():
            step = re.sub(r"^\s*(\d+\.|[-*])\s*", "", line).replace("**", "").strip()
    return title, step


def handoff_map(days=21):
    """{project dir: (mtime, newest handoff)} across ROOT."""
    latest = {}
    for p, m in handoff_files(ROOT, days):
        k = project_of(p)
        if m > latest.get(k, (0, None))[0]: latest[k] = (m, p)
    return latest


def task_handoff(t, latest):
    d = resolve_dir(t.f.get("at"))
    return max((v for k, v in latest.items() if k == d or d in k.parents), default=None) if d else None


def handoffs_cmd(args):
    days = int(args[0]) if args and args[0].isdigit() else 21
    latest = handoff_map(days)
    _, tasks = load()
    open_at = {}
    for t in tasks:
        if not t.done and "at" in t.f: open_at.setdefault(str(resolve_dir(t.f["at"])), []).append(t.id)
    nowts = dt.datetime.now().timestamp()
    print(bold("📄 HANDOFFS") + dim(f"  (newest per project, last {days} days)"))
    for k, (m, p) in sorted(latest.items(), key=lambda kv: -kv[1][0]):
        _, step = handoff_summary(p)
        age = ago(nowts - m)
        age = (grn if nowts - m < 3 * 86400 else yel if nowts - m < 10 * 86400 else red)(pad(age, 5))
        ids = open_at.get(str(k))
        tag = cyan(f" [{','.join(ids)}]") if ids else dim(" (no task)")
        name = short(k)
        name = name if len(name) <= 52 else "…" + name[-51:]
        print(f"  {age} {bold(name)}{tag}")
        if step: print(f"        {dim('→ ' + step[:110])}")


# ── html page: value ÷ effort ─────────────────────────────────────────────────
PUB = Path(os.environ.get("TYAT_PUBLISHER", ROOT / "article_publisher")).expanduser()
PAGE = Path(os.environ.get("TYAT_PAGE", APP / "next.html")).expanduser()
CAL_DONE = {"posted", "skipped", "scheduled", "done"}
POST_EST = {"ready": 15, "review": 30, "blocked": 45}  # minutes left on a calendar row by status


def est_min(s):
    m = re.fullmatch(r"(\d+)(m|h)", s or "")
    return int(m[1]) * (60 if m[2] == "h" else 1) if m else None


def urgency(due):
    if due is None: return 0
    h = (due - now).total_seconds() / 3600
    return 4 if h <= 0 else 3 if h <= 24 else 2 if h <= 72 else 1 if h <= 168 else 0


def leverage(value, mins):
    """value per unit of effort; effort grows slowly so big wins still beat busywork."""
    return value / math.log2(2 + mins / 15)


def activity_windows(days=21):
    """(prep, exec) start hours learned from your own prompt history (~/.claude/history.jsonl).
    exec = busiest 2h inside business hours (the people you send to are awake),
    prep = busiest 3h stretch outside it (deep work, when you are actually at the keyboard)."""
    counts, cutoff = [0] * 24, (now - dt.timedelta(days)).timestamp() * 1000
    try:
        with HIST.open(errors="ignore") as f:
            for line in f:
                m = re.search(r'"timestamp":\s*(\d+)', line)
                if m and int(m[1]) >= cutoff: counts[dt.datetime.fromtimestamp(int(m[1]) / 1000).hour] += 1
    except OSError: pass
    if sum(counts) < 50: return 22, 12, counts
    ex = max(range(9, 17), key=lambda h: counts[h] + counts[h + 1])
    prep = max((h for h in range(24) if all((h + i) % 24 not in (ex, ex + 1) for i in range(3))),
               key=lambda h: sum(counts[(h + i) % 24] for i in range(3)))
    return prep, ex, counts


def rhythm():
    """The day you are aiming for (not the one the history shows). Override with
    TYAT_RHYTHM="do=12,2 prep=22,3.5 sport=16,1.5 stop=01:30" (start hour, length in hours).
    Default: the night is the productive block; fewer hours come from dropping the scattered daytime work."""
    g = {"do": (12, 2), "prep": (22, 3.5), "sport": (16, 1.5), "stop": (1, 30), "deep": ((14, 2),)}
    for part in os.environ.get("TYAT_RHYTHM", "").split():
        k, _, v = part.partition("=")
        if k == "stop" and re.fullmatch(r"\d{1,2}:\d{2}", v): g[k] = tuple(map(int, v.split(":")))
        elif k in g and re.fullmatch(r"\d{1,2},\d+(\.\d+)?", v): g[k] = (int(v.split(",")[0]), float(v.split(",")[1]))
    return g


def after_stop(h, stop):
    """Is hour h between the shutdown time and 05:00?"""
    first = stop[0] + (stop[1] > 0)  # first full hour after the stop
    return first <= h < 5 if first < 5 else h >= first or h < 5


def night_share(counts_by_day, stop):
    """% of prompts after the shutdown time — the number to push down."""
    total = sum(counts_by_day) or 1
    late = sum(c for h, c in enumerate(counts_by_day) if after_stop(h, stop))
    return round(100 * late / total)


def schedule(items, g, horizon=30):
    """Lay items into the blocks of the next `horizon` hours. Prep work fits prep and deep blocks, do work
    only do blocks (or the prep block before, to queue it, when no do block comes in time).
    Deadlines still ahead go first (earliest first), then late items, then the rest by value ÷ effort;
    nothing goes into a block that starts after its deadline. A deadline no block can hold is worked
    right now, outside the rhythm (a "now" block); only what can't be done by its deadline even then overflows.
    Returns ([(start, kind, [items])], overflow)."""
    blocks = []
    for kind, wins in (("prep", [g["prep"]]), ("deep", g["deep"]), ("do", [g["do"]])):
        for h, n in wins:
            for day in range(-1, 3):  # -1: the night block that began yesterday may still be running
                start = (now + dt.timedelta(days=day)).replace(hour=h, minute=0)
                end = start + dt.timedelta(hours=n)
                if end > now and start < now + dt.timedelta(hours=horizon):
                    mins = (end - max(start, now)).total_seconds() / 60
                    blocks.append([max(start, now), mins, kind, [], mins])  # start, minutes left, kind, items, minutes total
    blocks.sort(key=lambda b: b[0])
    fits = {"prep": ("prep", "deep"), "exec": ("do",)}
    soon = now + dt.timedelta(hours=horizon)
    overflow, rush = [], [now, 0, "now", []]  # rush counts minutes already promised, not minutes left
    running = [b for b in blocks if b[0] == now]
    def order(i):
        if i["due"] and now < i["due"] <= soon: return (0, i["due"].timestamp())  # still savable: earliest deadline first
        if i["due"] and i["due"] <= now: return (1, -i["lev"])                    # already late
        return (2, -i["lev"])
    def in_time(b, i):  # done before the deadline, counting the work already in the block
        return b[0] + dt.timedelta(minutes=b[4] - b[1] + i["mins"]) <= i["due"]
    for i in sorted(items, key=order):
        free = [b for b in blocks if b[2] in fits[i["mode"]] and b[1] >= i["mins"]]
        if i["due"] and i["due"] > now:
            free = [b for b in free if in_time(b, i)]
            if not free and i["mode"] == "exec" and not i.get("day"):  # do block too late: queue it during prep
                free = [b for b in blocks if b[2] == "prep" and b[1] >= i["mins"] and in_time(b, i)]
        if free: free[0][1] -= i["mins"]; free[0][3].append(i)
        elif i["due"] and now < i["due"] and not (i.get("day") and not 9 <= now.hour < 20) and rush[1] + i["mins"] + sum(
                x["mins"] for b in running for x in b[3]) <= (i["due"] - now).total_seconds() / 60:
            rush[1] += i["mins"]; rush[3].append(i)
            for b in running: b[1] -= i["mins"]  # rush work eats the block we are in
        elif i["due"] and i["due"] <= soon: overflow.append(i)
    return [(b[0], b[2], b[3]) for b in ([rush] if rush[3] else []) + blocks], overflow


def next_slot(hour, length, not_before=None):
    """Start of the next window [hour, hour+length) — now, if we are inside it."""
    t = not_before or now
    start = t.replace(hour=hour, minute=0)
    if start > t: start -= dt.timedelta(days=1)
    return t if start <= t < start + dt.timedelta(hours=length) else start + dt.timedelta(days=1)


def calendar_rows(days=10):
    """Open rows of article_publisher's editorial calendar that are late or due within `days`."""
    cal = PUB / "docs/editorial-calendar.md"
    if not cal.exists(): return []
    try: weight = json.loads((PUB / "docs/priority.json").read_text())
    except (OSError, ValueError): weight = {}
    def clean(s): return re.sub(r"\*\*|`|~~|\*", "", s).strip(" —-")
    out, cols = [], None
    for line in cal.read_text(errors="ignore").splitlines():
        if not line.startswith("|"): cols = None; continue
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if "story" in cells and "target_datetime" in cells: cols = {c: i for i, c in enumerate(cells)}; continue
        if not cols or len(cells) < len(cols) or set(cells[0]) <= set("-: "): continue
        row = {c: cells[i] for c, i in cols.items()}
        status = (re.findall(r"[a-z]+", row.get("status", "").lower()) or [""])[0]
        if status in CAL_DONE: continue
        when = re.sub(r"~~.*?~~", "", row["target_datetime"])
        d = re.search(r"\d{4}-\d{2}-\d{2}", when)
        if not d: continue
        tm = re.search(r"\b(\d{1,2}):(\d{2})\b", when)
        due = dt.datetime.fromisoformat(d[0]).replace(hour=int(tm[1]) if tm else 9, minute=int(tm[2]) if tm else 0)
        if due.date() > now.date() + dt.timedelta(days): continue
        group = clean(row.get("group", ""))
        w = weight.get(group, {})
        out.append({"due": due, "title": clean(row["story"]), "channel": clean(row.get("channel", "")), "status": status,
                    "blocker": clean(row.get("blocker", "")), "group": group,
                    "reach": int(w.get("wichtigkeit", 3)) if isinstance(w, dict) else 3})
    return sorted(out, key=lambda r: r["due"])


# "Needs you": steps only Marty can do (send, post, call, approve, pay, pick up …). An agent can prepare them,
# never finish them. `me:1` / `me:0` on the task overrides the guess.
ME_WORDS = re.compile(r"\b(send\w*|sende\w*|schick\w*|verschick\w*|verteil\w*|posts?|posten|queue|call|anruf\w*|"
                      r"whatsapp|reply|antwort\w*|approve\w*|freigabe|pay|bezahl\w*|order|bestell\w*|pick up|abhol\w*|"
                      r"ask|frag\w*|talk|submit|einreich\w*|upload\w*|anmeld\w*|beantrag\w*|meeting|termin)\b", re.I)


# Of those, the ones that reach other people (send, call, talk …) happen while people are awake: do block only,
# never the night block, never queued at night. Fixed appointments (fix:1 or the words below) are never moved.
DAY_WORDS = re.compile(r"\b(send\w*|sende\w*|schick\w*|verschick\w*|verteil\w*|call|anruf\w*|whatsapp|reply|"
                       r"antwort\w*|ask|frag\w*|talk|order|bestell\w*|pick up|abhol\w*|meeting|termin)\b", re.I)
FIX_WORDS = re.compile(r"\b(meeting|termin|appointment|sprechstunde|begutachtung)\b", re.I)


def daytime(t): return needs_me(t) and bool(DAY_WORDS.search(t.text)) and t.f.get("me") != "0"
def fixed(t): return t.f.get("fix") == "1" or (t.f.get("fix") != "0" and bool(FIX_WORDS.search(t.text)))


def deadline(t):
    try: return dt.datetime.fromisoformat(t.f["dl"])
    except (KeyError, ValueError): return None


def needs_me(t):
    if t.f.get("me") in ("0", "1"): return t.f["me"] == "1"
    return bool(ME_WORDS.search(t.text))


def page_items(tasks, latest):
    items = []
    for t in tasks:
        if t.done: continue
        reach = int(t.f["reach"]) if t.f.get("reach", "").isdigit() else 2
        mins = est_min(t.f.get("est")) or 60
        value = 2 * reach + t.pri + 1.5 * urgency(t.due)
        hp = task_handoff(t, latest)
        items.append({"kind": "task", "mode": "exec" if mins <= 15 or daytime(t) else "prep", "day": daytime(t), "id": t.id, "title": t.text, "where": t.f.get("at", ""), "due": t.due,
                      "reach": reach, "pri": t.pri, "mins": mins, "est": "est" in t.f, "value": value,
                      "lev": leverage(value, mins), "next": t.next, "hand": hp and (hp[0], handoff_summary(hp[1])[1]),
                      "cmd": f"t go {t.id}", "me": needs_me(t)})
    for r in calendar_rows():
        if r["due"] < now - dt.timedelta(days=3): r["stale"] = True
        mins = POST_EST.get(r["status"], 60)
        value = 2 * r["reach"] + 1.5 * urgency(r["due"]) + (1 if r["status"] == "ready" else 0)
        items.append({**r, "kind": "post", "mode": "exec" if r["status"] == "ready" else "prep", "id": "📰", "where": r["channel"], "pri": 0, "mins": mins, "est": True,
                      "value": value, "lev": leverage(value, mins), "next": r["blocker"], "hand": None,
                      "cmd": f"cd {PUB} && npm run -s plan", "me": r["status"] == "ready"})
    return sorted(items, key=lambda i: -i["lev"])


