C = sys.stdout.isatty()
def col(code, s): return f"\033[{code}m{s}\033[0m" if C else s
red, yel, grn, dim, bold, cyan = (lambda s, c=c: col(c, s) for c in ("31", "33", "32", "2", "1", "36"))

