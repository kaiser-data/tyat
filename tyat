def workday_start():
    """The working day runs 05:00–05:00, so the night block belongs to the day it started in."""
    d = (now - dt.timedelta(hours=5)).date()
    return dt.datetime(d.year, d.month, d.day, 5, 0)


def prompts_since(start):
    counts = [0] * 24
    try:
        with HIST.open(errors="ignore") as f:
            for line in f:
                m = re.search(r'"timestamp":\s*(\d+)', line)
                if m and int(m[1]) >= start.timestamp() * 1000: counts[dt.datetime.fromtimestamp(int(m[1]) / 1000).hour] += 1
    except OSError: pass
    return counts


def report(tasks, g):
    start = workday_start()
    done = [t for t in tasks if t.done and t.f.get("done", "") >= start.isoformat(timespec="minutes")]
    late = [t for t in tasks if not t.done and t.due and t.due <= now]
    soon = [t for t in tasks if not t.done and t.due and now < t.due <= now + dt.timedelta(hours=24)]
    counts = prompts_since(start)
    return {"start": start, "done": done, "late": late, "soon": soon, "prompts": sum(counts),
            "after_stop": sum(c for h, c in enumerate(counts) if after_stop(h, g["stop"]))}


def report_text(r, g):
    def names(ts): return ", ".join(speakable(t.text) for t in ts[:3]) + (f" und {len(ts) - 3} weitere" if len(ts) > 3 else "")
    out = [f"Tagesbericht. Erledigt: {len(r['done'])}" + (f", nämlich {names(r['done'])}." if r["done"] else ". Noch nichts abgehakt.")]
    if r["late"]: out.append(f"Überfällig: {len(r['late'])}, zuerst {names(r['late'][:1])}. Erledigen oder mit t snooze verschieben.")
    if r["soon"]: out.append(f"In den nächsten 24 Stunden fällig: {len(r['soon'])}.")
    if r["after_stop"]: out.append(f"{r['after_stop']} von {r['prompts']} Prompts lagen nach {g['stop'][0]} Uhr {g['stop'][1] or ''}.".replace(" .", "."))
    return " ".join(out)


