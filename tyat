def plan_api(method, path, data=None, ctype=None):  # a 404 returns None
    """Call the plan Worker's inbox API with the page key (URL from $TYAT_PLAN_URL or ./.plan-url)."""
    import urllib.error
    import urllib.request
    url = os.environ.get("TYAT_PLAN_URL") or ((APP / ".plan-url").read_text().strip() if (APP / ".plan-url").exists() else "")
    key = (APP / ".plan-key").read_text().strip() if (APP / ".plan-key").exists() else ""
    if not url or not key: sys.exit("t inbox needs the plan URL ($TYAT_PLAN_URL or .plan-url) and .plan-key")
    req = urllib.request.Request(f"{url.rstrip('/')}{path}?k={key}", data=data, method=method,
                                 headers={"user-agent": f"tyat/{__version__}", **({"content-type": ctype} if ctype else {})})
    try:
        with urllib.request.urlopen(req, timeout=60) as r: return r.read()
    except urllib.error.HTTPError as e:
        if e.code == 404: return None
        sys.exit(f"plan inbox: {method} {path} failed ({e})")
    except OSError as e: sys.exit(f"plan inbox: {method} {path} failed ({e})")  # HTTPError/URLError, never the key


def transcribe(audio, ctype, key):
    """ElevenLabs speech-to-text (multipart upload, stdlib only)."""
    import urllib.request
    ext = {"audio/mp4": "m4a", "audio/webm": "webm", "audio/ogg": "ogg", "audio/mpeg": "mp3", "audio/wav": "wav"}.get(ctype, "bin")
    b = uuid.uuid4().hex
    body = (f'--{b}\r\nContent-Disposition: form-data; name="model_id"\r\n\r\n'
            f'{os.environ.get("ELEVENLABS_STT_MODEL", "scribe_v1")}\r\n'
            f'--{b}\r\nContent-Disposition: form-data; name="file"; filename="memo.{ext}"\r\nContent-Type: {ctype}\r\n\r\n').encode()
    body += audio + f"\r\n--{b}--\r\n".encode()
    req = urllib.request.Request("https://api.elevenlabs.io/v1/speech-to-text", data=body,
                                 headers={"xi-api-key": key, "content-type": f"multipart/form-data; boundary={b}"})
    with urllib.request.urlopen(req, timeout=120) as r: return json.loads(r.read())["text"].strip()


def inbox_cmd(args):
    """Fetch feedback from the phone page, transcribe voice memos, append to inbox.md, delete it remotely.
    --claude hands the new notes to a Claude Code session that proposes t done/next/snooze/add."""
    new = []
    for m in json.loads(plan_api("GET", "/api/inbox")):
        when = dt.datetime.fromtimestamp(int(m["id"].split("-")[0]) / 1000)
        raw, ctype = plan_api("GET", f"/api/inbox/{m['id']}"), m.get("type", "")
        if raw is None: continue  # already fetched: KV listings lag deletes by up to a minute
        if ctype.startswith("text/"): text = raw.decode(errors="replace").strip()
        else:
            key = eleven_key()
            if not key: print(yel(f"{m['id']}: no ElevenLabs key, voice memo left in the inbox")); continue
            try: text = transcribe(raw, ctype, key)
            except OSError as e: print(red(f"{m['id']}: transcription failed ({e}), left in the inbox")); continue
        with INBOX.open("a") as f: f.write(f"\n## {when:%Y-%m-%d %H:%M} · {'🎙' if ctype.startswith('audio') else '✍️'}\n{text}\n")
        plan_api("DELETE", f"/api/inbox/{m['id']}")
        new.append((when, text))
    if not new: return print(dim("inbox empty"))
    for when, text in new: print(f"{bold(f'{when:%a %H:%M}')}  {text}")
    print(dim(f"→ appended to {INBOX}"))
    if "--claude" in args:
        notes = "\n".join(f"- {w:%a %H:%M}: {t}" for w, t in new)
        prompt = (f"Feedback von Marty vom Handy (Sprachnotizen/Notizen):\n{notes}\n\nLies tasks.md und schlag passende "
                  "t done / t next / t snooze / t add vor (Skill delegating-to-tyat). Erst zeigen, dann nach OK ausführen.")
        launch(APP, "claude", ["claude", prompt])


def ticks_sync(quiet=False):
    """Phone ticks → tasks.md. A ticked task is marked done (and the tick flagged applied, so the page keeps
    showing it ticked); unticking a task the phone finished reopens it. Calendar rows are only kept in sync
    between devices. Returns the lines it changed."""
    st = state(); by_phone = st.setdefault("phone_done", {})
    head, tasks = load(); changed, out = False, []
    for x in json.loads(plan_api("GET", "/api/ticks") or b"[]"):
        tid = x.get("tid")
        if not tid: continue
        t = next((t for t in tasks if t.id == tid and (not t.done or by_phone.get(tid) == t.f.get("done"))), None)
        if not t: continue
        if x.get("on") and not t.done:
            t.done = True; t.f["done"] = now.isoformat(timespec="minutes"); by_phone[tid] = t.f["done"]
            out.append(f"✓ [{tid}] {t.text}  {dim('(ticked on the phone)')}"); changed = True
        elif not x.get("on") and t.done:
            t.done = False; t.f.pop("done", None); by_phone.pop(tid, None)
            out.append(f"↺ [{tid}] {t.text}  {dim('(unticked on the phone, reopened)')}"); changed = True
        else: continue
        if x.get("on"):
            plan_api("PUT", f"/api/ticks/{urllib.parse.quote(x['k'], safe='')}",
                     json.dumps({"on": True, "tid": tid, "t": x.get("t", ""), "applied": True}).encode(), "application/json")
    if changed:
        shutil.copy(TASKS, TASKS.with_name(TASKS.name + ".bak-ticks")); save(head, tasks); STATE.write_text(json.dumps(st, indent=1))
    for line in out: print(line)
    if not out and not quiet: print(dim("no new ticks"))
    return out


