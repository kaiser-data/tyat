def eleven_key():
    k = os.environ.get("ELEVENLABS_API_KEY", "")
    p = HOME / ".config/elevenlabs/key"
    return k or (p.read_text().strip() if p.exists() else "")


def tts(text, key):
    import urllib.request
    voice = os.environ.get("ELEVENLABS_VOICE", "JBFqnCBsd6RMkjVDRZzb")
    req = urllib.request.Request(
        f"https://api.elevenlabs.io/v1/text-to-speech/{voice}?output_format=mp3_44100_64",
        data=json.dumps({"text": text, "model_id": "eleven_multilingual_v2",
                         "voice_settings": {"stability": 0.5, "similarity_boost": 0.75}}).encode(),
        headers={"xi-api-key": key, "content-type": "application/json", "accept": "audio/mpeg"})
    with urllib.request.urlopen(req, timeout=60) as r: return r.read()


def render_voices(texts, out, cache, say=tts):
    """Write out/<key>.mp3 per section. Clips are cached by text hash in `cache` (outside the deployed folder),
    so an unchanged briefing costs no ElevenLabs characters. out/ ends up holding exactly the clips of this
    page: an old clip never plays for a changed briefing, and nothing stale stays deployed."""
    import hashlib
    out.mkdir(parents=True, exist_ok=True); cache.mkdir(parents=True, exist_ok=True)
    key, spent, keep, why = None, 0, set(), "no ElevenLabs key ($ELEVENLABS_API_KEY or ~/.config/elevenlabs/key)"
    for name, text in texts.items():
        clip = cache / (hashlib.sha1(text.encode()).hexdigest()[:16] + ".mp3")
        if not clip.exists():
            key = key if key is not None else eleven_key()
            if not key: continue
            try: clip.write_bytes(say(text, key)); spent += len(text)
            except OSError as e:  # quota used up (401), offline …: the page still deploys, these blocks stay silent
                key, why = "", f"ElevenLabs failed ({e}; quota?)"; continue
        shutil.copyfile(clip, out / f"{name}.mp3"); keep.add(f"{name}.mp3")
    for f in out.iterdir():
        if f.name not in keep: shutil.rmtree(f) if f.is_dir() else f.unlink()
    if len(keep) < len(texts): print(yel(f"{why}: {len(texts) - len(keep)} blocks without voice"))
    return spent


def guarded(plan):
    """Only deploy behind the key guard: a plain assets deploy would make the plan public. Checks the parsed
    config (comments stripped), that its entry point is the worker and that the worker checks the key."""
    try:
        cfg = json.loads(re.sub(r'("(?:\\.|[^"\\])*")|//[^\n]*|/\*.*?\*/', lambda m: m[1] or "",
                                (plan / "wrangler.jsonc").read_text(), flags=re.S))
        main = plan / cfg["main"]
        worker = main.read_text()
    except (OSError, ValueError, KeyError, TypeError): return False
    assets = cfg.get("assets") or {}
    return (assets.get("run_worker_first") is True and main.resolve().parent == plan.resolve()
            and "PLAN_KEY" in worker and "401" in worker)


